# Copy to .dev.vars for local development (`wrangler pages dev`).
# For Cloudflare Pages production, set each secret with:
#   wrangler pages secret put <NAME> --project-name=gym-gang

# Required for /admin login & signed session cookies
ADMIN_PASSWORD=change-me-strong-admin-password
SESSION_SECRET=change-me-32-byte-random-hex-secret

# Optional: Paymob Accept Egypt payment gateway (Card / Wallet checkout)
# Leave blank to keep Cash on Delivery + InstaPay/Vodafone Cash only
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Optional: Resend transactional email for newsletter welcome emails
RESEND_API_KEY=
MAIL_FROM=Gym Gang <noreply@yourdomain.com>
